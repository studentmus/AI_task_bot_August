# Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
DEEPSEEK_API_KEY=your_deepseek_key_here

# Database
DATABASE_PATH=data/tasks.db

# Calendar
RADICALE_URL=https://cal.yourdomain.com/user/calendar.ics/
RADICALE_USER=your_username
RADICALE_PASSWORD=your_password

# Obsidian Vault (local dev / prod path)
OBSIDIAN_VAULT_PATH=/home/adminlinux/MyBrain

# Scheduler
SCHEDULER_ENABLED=true
